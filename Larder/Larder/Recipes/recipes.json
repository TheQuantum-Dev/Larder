  {
    "id": "egg-fried-rice",
    "title": "Egg fried rice",
    "emoji": "🍳",
    "minutes": 15,
    "servings": 1,
    "equipment": [
      "pan"
    ],
    "ingredients": [
      {
        "id": "rice",
        "amount": "1 cup cooked rice (day-old is best)",
        "qty": 1,
        "grams": 158,
        "nutri": "rice-cooked"
      },
      {
        "id": "egg",
        "amount": "2 eggs",
        "qty": 2,
        "grams": 100
      },
      {
        "id": "frozen-veg",
        "amount": "½ cup frozen peas and carrots",
        "qty": 0.5,
        "alt": [
          "peas",
          "carrot",
          "corn"
        ],
        "grams": 70
      },
      {
        "id": "soy-sauce",
        "amount": "1 tbsp soy sauce",
        "qty": 1,
        "grams": 16
      },
      {
        "id": "onion",
        "amount": "¼ onion, diced",
        "qty": 0.25,
        "optional": true
      },
      {
        "id": "garlic",
        "amount": "1 garlic clove, minced",
        "qty": 1,
        "optional": true
      },
      {
        "id": "cooking-oil",
        "amount": "1 tbsp oil",
        "qty": 0,
        "grams": 14
      }
    ],
    "steps": [
      {
        "text": "No cooked rice? Simmer ½ cup dry rice with 1 cup water, lid on, on low heat for 15 minutes, then let it sit 5 minutes and fluff it. Skip this if you already have cooked rice.",
        "timer": 900
      },
      {
        "text": "Heat the oil in a pan over medium-high heat. Add the veg (and the onion or garlic, if using) and stir for 3 minutes.",
        "timer": 180
      },
      {
        "text": "Push everything to one side and scramble the eggs on the other, stirring until they are fully set with no runny bits.",
        "timer": 90
      },
      {
        "text": "Add the rice and soy sauce and stir-fry for 3 minutes, until everything is steaming hot.",
        "timer": 180
      }
